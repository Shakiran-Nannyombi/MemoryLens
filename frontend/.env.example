# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Groq API Configuration (for AI/LLM features)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Midnight Blockchain Configuration
VITE_MIDNIGHT_NETWORK=testnet
VITE_MIDNIGHT_CONTRACT_ADDRESS=your_deployed_contract_address_here
VITE_MIDNIGHT_PROOF_SERVER=https://proof-server.testnet.midnight.network

# Optional: Set to 'true' to enable Midnight integration by default
VITE_MIDNIGHT_ENABLED=false

